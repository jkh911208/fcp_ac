<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Final Cut Pro hands over the media as a security-scoped bookmark inside the FCPXML;
	     resolving one needs this. Without it the panel can see a clip's path and still not open it. -->
	<key>com.apple.security.files.bookmarks.document-scope</key>
	<true/>
	<!-- read-write, not read-only: the caption file is saved wherever the user points the save
	     panel, and a sandbox grants that only through the panel itself. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- "Disable Library Validation" from the release notes: the SDK is not fully compatible with
	     Hardened Runtime, and with library validation on the extension simply does not load. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- The scripting-targets group below is read-only: Final Cut Pro's dictionary declares
	     com.apple.FinalCut.library.inspection with access="r", and the standard `open` command is
	     not in it. Sending `open` through it fails with "A privilege violation occurred", which is
	     what the panel hit the first time it tried to deliver a document. A temporary exception is
	     what covers the rest of the Apple Event surface. -->
	<key>com.apple.security.temporary-exception.apple-events</key>
	<array>
		<string>com.apple.FinalCut</string>
		<string>com.apple.FinalCutApp</string>
		<string>com.apple.FinalCutTrial</string>
	</array>
	<!-- From the SDK release notes. ProExtensionHost uses Apple Events as its transport, so a
	     sandboxed extension needs permission to target Final Cut Pro and its variants.
	     com.apple.FinalCutApp is the variant the January 2026 notes added. -->
	<key>com.apple.security.scripting-targets</key>
	<dict>
		<key>com.apple.FinalCut</key>
		<array>
			<string>com.apple.FinalCut.library.inspection</string>
		</array>
		<key>com.apple.FinalCutApp</key>
		<array>
			<string>com.apple.FinalCut.library.inspection</string>
		</array>
		<key>com.apple.FinalCutTrial</key>
		<array>
			<string>com.apple.FinalCut.library.inspection</string>
		</array>
	</dict>
</dict>
</plist>
